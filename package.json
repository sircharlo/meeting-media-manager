{
  "name": "meeting-media-manager",
  "version": "26.11.3-beta.2",
  "description": "A cross platform app to download and present media for congregation meetings of Jehovah’s Witnesses.",
  "keywords": [
    "M³",
    "jw",
    "m3",
    "meeting media manager"
  ],
  "homepage": "https://sircharlo.github.io/meeting-media-manager/",
  "bugs": "https://github.com/sircharlo/meeting-media-manager/issues",
  "license": "AGPL-3.0-or-later",
  "author": "Olivier Savignac",
  "repository": {
    "type": "git",
    "url": "https://github.com/sircharlo/meeting-media-manager.git"
  },
  "scripts": {
    "electron-rebuild": "electron-rebuild -f -m ./node_modules/robotjs",
    "generate:icons": "node ./build/svg2font.js",
    "generate:jw-icons-fallbacks": "node ./scripts/update-jw-icons-fallbacks.mjs",
    "generate:logos": "node ./build/generate-logos.js",
    "refresh:jw-icons-fallbacks": "node ./scripts/refresh-jw-icons-fallbacks.mjs",
    "fix:i18n": "node scripts/fix-i18n-locales.mjs",
    "fix:docs": "node docs/utils/fix-doc-markdown.mjs",
    "dev": "node scripts/fix-i18n-locales.mjs && quasar dev -m electron",
    "build": "node scripts/fix-i18n-locales.mjs && quasar build -m electron",
    "build:debug": "node scripts/fix-i18n-locales.mjs && quasar build -m electron --debug",
    "build:unpacked": "node scripts/fix-i18n-locales.mjs && quasar build -m electron --skip-pkg",
    "docs:build": "node docs/utils/fix-doc-markdown.mjs --check && vitepress build docs",
    "docs:dev": "node docs/utils/fix-doc-markdown.mjs --check && vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "docs:lint": "node docs/utils/fix-doc-markdown.mjs --check && eslint -c ./eslint.config.js './docs/**/*.{js,ts,cjs,mjs,mts,vue}' && vue-tsc --noEmit -p docs/tsconfig.json",
    "docs:test": "node docs/utils/fix-doc-markdown.mjs --check && vitest --project docs",
    "format": "prettier \"**/*\" --ignore-unknown --write",
    "lint": "eslint -c ./eslint.config.js './src/**/*.{js,ts,cjs,mjs,mts,vue}' './src-electron/**/*.{js,ts,cjs,mjs,mts}' && vue-tsc --noEmit -p tsconfig.json",
    "depcheck": "depcheck --skip-missing && depcheck src-electron --skip-missing",
    "test:unit": "node scripts/fix-i18n-locales.mjs && vitest --project quasar --project electron",
    "test:zoom-hand": "vitest run --config test/zoom-live/vitest.config.mts test/zoom-live/zoom-hand.live.test.ts",
    "test:zoom-live": "vitest run --config test/zoom-live/vitest.config.mts",
    "test:zoom-share": "vitest run --config test/zoom-live/vitest.config.mts test/zoom-live/zoom-share.live.test.ts",
    "screenshot:refresh": "node test/playwright/run.mjs"
  },
  "dependencies": {
    "@carboneio/image-size": "3.0.1",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@formkit/drag-and-drop": "^0.7.0",
    "@numairawan/video-duration": "^1.0.0",
    "@quasar/extras": "^2.1.0",
    "@sentry/core": "^11.12.0",
    "@sentry/electron": "^8.4.0",
    "@sentry/vue": "^11.12.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "buffer": "^6.0.3",
    "check-disk-space": "^4.0.0",
    "cheerio": "^1.2.0",
    "chokidar": "^6.0.0",
    "countries-and-timezones": "^3.11.0",
    "dompurify": "^3.4.17",
    "electron-updater": "^6.8.11",
    "fluent-ffmpeg": "^2.1.3",
    "fontkit": "^2.0.4",
    "fs-extra": "^11.4.1",
    "heic-convert": "^2.1.0",
    "is-online": "^12.0.2",
    "mime": "^4.1.2",
    "mousetrap": "^1.6.5",
    "music-metadata": "^12.4.0",
    "obs-websocket-js": "^5.0.8",
    "p-queue": "^10.0.0",
    "pdf-parse": "^2.4.5",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "pretty-bytes": "^7.2.0",
    "quasar": "^2.35.4",
    "robotjs": "^0.9.1",
    "type-fest": "^5.10.0",
    "upath": "^3.0.8",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.19",
    "vue-router": "^5.5.0",
    "vue-zoomable": "^1.2.8",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@eslint/config-helpers": "^0.7.0",
    "@eslint/js": "^10.0.1",
    "@intlify/message-compiler": "11.4.19",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@pinia/testing": "^2.0.2",
    "@quasar/app-vite": "^3.10.4",
    "@quasar/vite-plugin": "^2.0.2",
    "@sentry/rollup-plugin": "^11.12.0",
    "@sentry/vite-plugin": "^11.12.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/fontkit": "^2.0.9",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash-es": "^4.17.12",
    "@types/mousetrap": "^1.6.15",
    "@types/node": "^26.6.6",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/compiler-dom": "^3.5.45",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "depcheck": "^1.4.7",
    "electron": "^45.3.1",
    "electron-builder": "26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-vue": "^10.12.1",
    "fantasticon": "patch:fantasticon@npm%3A4.1.0#~/.yarn/patches/fantasticon-npm-4.1.0-3af043d076.patch",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash-es": "^4.18.1",
    "msw": "^3.0.5",
    "playwright": "^1.65.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "sharp": "^0.35.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "vitepress": "^2.0.0-alpha.21",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "browserslist": [
    "Electron >= 37"
  ],
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,ts,cjs,mjs,mts,vue}": "eslint --fix"
  },
  "engines": {
    "node": "^24.14.0",
    "yarn": "^4.13.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "private": true,
  "type": "module",
  "resolutions": {
    "plist": "3.1.1"
  },
  "packageManager": "yarn@4.18.1",
  "productName": "Meeting Media Manager"
}
